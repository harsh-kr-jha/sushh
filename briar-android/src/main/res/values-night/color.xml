<?xml version="1.0" encoding="utf-8"?>
<resources>

	<!-- FIX: was hardcoded maroon (#881A27) — this is the direct
	     cause of the red header in dark mode. Lighter blue is used
	     (not the light-theme's deep blue_800_new) so it still pops
	     against a near-black background. -->
	<color name="briar_primary">@color/briar_blue_400_new</color>
	<!-- FIX: was #2B2E3B, nearly the same darkness as the window
	     background below (contrast ~1.3:1 — effectively invisible
	     as a surface). Lightened so it reads as a distinct surface. -->
	<color name="briar_accent">@color/briar_night_600</color>

	<color name="preference_category_background">@color/briar_night_950</color>

	<color name="color_primary">@android:color/white</color>

	<color name="msg_in">@color/briar_night_700</color>
	<color name="msg_out">@color/briar_blue_600_new</color>
	<color name="notice_in">@color/briar_night_800</color>
	<color name="notice_out">@color/briar_blue_800_new</color>
	<!-- FIX: was msg_stroke_dark (@color/briar_gray_900, #2e2e2e),
	     almost the same darkness as msg_in (#2e3d4f) — the bubble
	     outline was effectively invisible. Light stroke shows up
	     against a dark bubble; use light in both themes. -->
	<color name="msg_stroke">@color/msg_stroke_light</color>

	<!-- FIX: window_background/card_background were set to WHITE
	     inside the night file — a dark theme with a white background
	     is almost certainly the other half of what you were seeing. -->
	<color name="window_background">@color/briar_night_950</color>
	<color name="card_background">@color/briar_night_800</color>
	<!-- FIX: was briar_gray_200 (#dfdfdf, light gray) — a bright
	     box on a dark screen. Swapped for a lighter dark-blue tint,
	     matching il_background below (#334155). -->
	<color name="item_background_highlight">@color/briar_night_700_new</color>

	<color name="briar_button_text_neutral">@color/briar_blue_400_new</color>
	<!-- FIX: was #23cccccc — ~14% opacity, close to unreadable.
	     Standard Material dark-theme disabled-content opacity (~38%). -->
	<color name="briar_button_text_disabled">#61ffffff</color>

	<!-- FIX: was briar_night_700 (#2e3d4f), contrast ~1.6:1 against
	     the dark background — invisible. Needs a genuinely light
	     tone to read as an indicator on a dark screen. -->
	<color name="thread_indicator">@color/briar_gray_500</color>
	<!-- FIX: was pure black — indistinguishable from the near-black
	     window background, so "highlighted" showed as nothing. -->
	<color name="thread_item_highlight">@color/briar_night_700</color>

	<!-- FIX: was pure black — invisible against a near-black
	     background, so section dividers weren't showing at all. -->
	<color name="divider">@color/briar_night_700</color>

	<color name="il_border">#64748B</color>
	<color name="il_background">#334155</color>
	<color name="il_lime">@color/briar_lime_400_new</color>
	<color name="il_orange">@color/briar_orange_400</color>
	<color name="il_red">@color/briar_red_500_new</color>

	<!-- ADDED: primary/secondary M3 tokens weren't overridden here
	     at all, so dark mode was silently inheriting whatever the
	     base colors.xml defines for md_theme_primary — which is a
	     second, separate path back to red/maroon if the base file
	     isn't also fixed. Making this file self-contained. -->
	<color name="md_theme_primary">@color/briar_blue_400_new</color>
	<color name="md_theme_onPrimary">@color/briar_night_950</color>
	<color name="md_theme_primaryContainer">@color/briar_blue_900</color>
	<color name="md_theme_onPrimaryContainer">@color/briar_blue_100</color>
	<color name="md_theme_secondary">@color/briar_accent</color>
	<color name="md_theme_onSecondary">@android:color/white</color>

	<color name="md_theme_tertiary">@color/briar_blue_400_new</color>
	<!-- FIX: was briar_blue_900 (#184080) — contrast on the tertiary
	     bg above is only ~4.2:1, borderline for normal text. Using
	     the near-black bg tone gets a safer ~7.5:1. -->
	<color name="md_theme_onTertiary">@color/briar_night_950</color>
	<color name="md_theme_tertiaryContainer">@color/briar_blue_800_new</color>
	<color name="md_theme_onTertiaryContainer">@color/briar_blue_300</color>
	<!-- FIX: was #1F1F1F — near-black text on a near-black background
	     (once window_background is correctly dark) would be unreadable.
	     This is likely the biggest functional bug in the file. -->
	<color name="md_theme_onBackground">#E8E8E8</color>
	<color name="md_theme_onSurface">#E8E8E8</color>
	<!-- FIX: was briar_gray_200_new (#E5E7EB, light gray) — a bright
	     surface tone inside a dark theme. Dimmest surface should be
	     dark, not light. -->
	<color name="md_theme_surfaceDim">@color/briar_night_950</color>
	<color name="md_theme_error">@color/briar_red_400</color>
</resources>
